# ==========================================================
# THREADS AUTONOMOUS CREATOR AGENT - ENVIRONMENT VARIABLES
# ==========================================================

# Server & App Config
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=threads_agent_secret_cron_key_999

# MongoDB Atlas Connection
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=threads_agent

# Meta Threads Graph API v1.0
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
DRY_RUN=true

# AI Engines (Tier 1: Groq Multi-Key Rotator - Comma-separated)
GROQ_API_KEYS=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Optional Failovers
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=qwen/qwen3.8-max

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
